# CSRGO AI Video Studio — Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Ollama local inference endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Planning model for scriptwriting, director treatments, and storyboards
OLLAMA_MODEL=qwen3:1.7b

# Coding model for Claude Code animation components and visual code generation
OLLAMA_CODE_MODEL=qwen2.5-coder:3b

# SQLite Database storage URL
DATABASE_URL=sqlite:///./csrgo_video_studio.db

# Backend server host and port
HOST=127.0.0.1
PORT=8000

# Optional persistent unified key for your FreeLLMAPI desktop.
# Set this in your ignored .env or backend environment, never commit the real value.
# FREELLMAPI_API_KEY=
# Optional system Chromium executable (otherwise use Playwright's installed browser).
# CHROMIUM_EXECUTABLE=

# Optional explicit Remotion browser selection. Otherwise its bundled browser is used.
# REMOTION_BROWSER_EXECUTABLE=
# Optional Remotion license key when required by your license.
# REMOTION_PRIVATE_LICENSE_KEY=
